# Paste your API keys here (do not commit real secrets)

PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/amb_saas_db
JWT_SECRET=amb_saas_super_secret_jwt_key_2026

# ── Notifications ──────────────────────────────────────────
# demo = log only (works now for judges)
# live = send via Twilio + Resend when keys below are set
NOTIFY_MODE=demo

# ── OpenAI (Document Checklist NLP extraction) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Twilio WhatsApp (Alert Agent) ──────────────────────────
# Example FROM for sandbox: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Resend Email (Alert Agent) ─────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@joblytic.ai

# After pasting keys:
# 1) Set NOTIFY_MODE=live
# 2) Restart backend: npm start (in /backend)
# 3) Dashboard → Trace tab → "Run Dual Agents"

# ── Scraping Agent ─────────────────────────────────────────
# Playwright Chromium for JS-heavy / Cloudflare portals (default on)
SCRAPE_USE_PLAYWRIGHT=1
# Auto scrape every 6 hours (cron). Set to 0 to disable.
SCRAPE_CRON_ENABLED=1
SCRAPE_CRON=0 */6 * * *
